{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "define-company",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    // The Vite build, with the dataset copied into dist/data.
    "directory": "./dist",
    "binding": "ASSETS",
    // Everything is a static file except the EDGAR proxy.
    "run_worker_first": ["/sec-www/*", "/sec-data/*", "/sec-efts/*"]
  },
  "observability": { "enabled": true }
}
