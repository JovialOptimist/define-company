# Copy this file to .env.local and fill in your details.
#
# SEC EDGAR requires a User-Agent with a name (yours or your app's) and a
# contact email: https://www.sec.gov/os/accessing-edgar-data
# Without an email, EDGAR answers 403 Forbidden.
# The Vite dev/preview proxy sends it with every EDGAR request.
SEC_USER_AGENT=Jane Doe you@example.com
